<Window x:Class="AegisComputerUse.App.ConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтверждение безопасности Aegis"
        Width="490"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Topmost="True"
        Background="#14171F">
    <Border BorderBrush="#F59E0B" BorderThickness="1.5" CornerRadius="10" Margin="6" Padding="18" Background="#14171F">
        <StackPanel>
            <TextBlock Text="⚠ ТРЕБУЕТСЯ ПОДТВЕРЖДЕНИЕ ДЕЙСТВИЯ"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="#F59E0B"
                       Margin="0,0,0,10"/>

            <Border Background="#0D0F14" BorderBrush="#262C38" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock x:Name="ActionSummaryText" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ReasonText" Foreground="#CBD5E1" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Разрешение действует только для этого единичного шага."
                       Foreground="#8B94A6" FontSize="11.5" Margin="0,0,0,14"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отклонить и остановить"
                        Style="{StaticResource DangerButton}"
                        IsDefault="True"
                        IsCancel="True"
                        Click="OnDenyClick"
                        Margin="0,0,10,0"/>
                <Button Content="Разрешить (1 раз)"
                        Style="{StaticResource PrimaryButton}"
                        Click="OnApproveClick"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
