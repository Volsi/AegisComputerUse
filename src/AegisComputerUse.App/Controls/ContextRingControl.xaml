<UserControl x:Class="AegisComputerUse.App.Controls.ContextRingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Cursor="Hand"
             Height="28"
             ToolTip="Использование контекстного окна модели (нажмите для деталей)">
    <Border x:Name="RootBorder"
            BorderThickness="1"
            CornerRadius="14"
            Padding="9,4">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#202532"/>
                        <Setter Property="BorderBrush" Value="#2D3444"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Grid Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center">
                <Ellipse Stroke="#353B47" StrokeThickness="2.1"/>
                <Path x:Name="ProgressArc"
                      Stroke="#D1D5DB"
                      StrokeThickness="2.1"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"/>
            </Grid>
            <TextBlock x:Name="TokensLabel"
                       Text="0"
                       FontSize="12"
                       Foreground="#A1A8B3"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>
