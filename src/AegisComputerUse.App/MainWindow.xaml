<Window x:Class="AegisComputerUse.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AegisComputerUse.App.Controls"
        Title="Aegis Computer Use — Protected AI Desktop Agent"
        Icon="pack://application:,,,/AegisComputerUse;component/Assets/Aegis.ico"
        Width="1200"
        Height="790"
        MinWidth="860"
        MinHeight="620"
        AllowDrop="True"
        Drop="OnWindowDrop"
        DragOver="OnWindowDragOver"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        PreviewMouseDown="OnWindowPreviewMouseDown"
        StateChanged="OnWindowStateChanged"
        Background="#0B0D12">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="WindowRootBorder" Background="#0B0D12" BorderBrush="#1F2533" BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Padding" Value="7"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Integrated Obsidian Header Chrome (Antigravity + OpenCode inspired, no sidebar) -->
        <Border Grid.Row="0"
                Background="#0F1219"
                BorderBrush="#1E2430"
                BorderThickness="0,0,0,1"
                Padding="14,0,8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Custom Crisp Vector Shield Mark -->
                    <Border Background="#121826"
                            BorderBrush="#253247"
                            BorderThickness="1"
                            CornerRadius="7"
                            Width="26"
                            Height="26"
                            Margin="0,0,9,0"
                            VerticalAlignment="Center">
                        <Canvas Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M8,1.5 L13.5,3.7 L13.5,7.8 C13.3,11.2 11.1,13.5 8,14.7 C4.9,13.5 2.7,11.2 2.5,7.8 L2.5,3.7 Z"
                                  Stroke="#38BDF8"
                                  StrokeThickness="1.35"
                                  Fill="#2438BDF8"/>
                            <Path Data="M5.5,10.2 L8,5.2 L10.5,10.2"
                                  Stroke="#ECEEF2"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Canvas>
                    </Border>

                    <TextBlock Text="AEGIS"
                               FontSize="13.5"
                               FontWeight="Bold"
                               Foreground="#ECEEF2"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="/"
                               FontSize="13"
                               Foreground="#3F495E"
                               Margin="7,0,7,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Computer Use"
                               FontSize="12.5"
                               FontWeight="Medium"
                               Foreground="#38BDF8"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"/>

                    <Border x:Name="HardeningPill"
                            Background="#0C1F18"
                            BorderBrush="#164E3A"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="8,2.5"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="HardeningBadgeText"
                                   Text="AES-GCM • TLS 1.3 • Anti-Capture"
                                   FontFamily="Cascadia Code, Consolas"
                                   FontSize="10.5"
                                   Foreground="#34D399"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Vault / Model Key Status Pill (clickable -> Settings) -->
                    <Button x:Name="TopKeyStatusBtn"
                            Style="{StaticResource GhostPillButton}"
                            Padding="9,4"
                            Margin="0,0,6,0"
                            Click="OnOpenSettingsClick"
                            ToolTip="Нажмите, чтобы добавить модель или управлять API-ключами">
                        <TextBlock x:Name="TopKeyStatusText"
                                   Text="⚠ Модель не добавлена"
                                   FontSize="11.5"
                                   Foreground="#F59E0B"/>
                    </Button>

                    <Border Background="#141822"
                            BorderBrush="#222938"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8,3"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            ToolTip="Режим наблюдения и анализа экрана в реальном времени активен">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#34D399" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LiveScreenBadge"
                                       Text="Live Экран"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="#34D399"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#141822"
                            BorderBrush="#222938"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8,3"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            ToolTip="Аппаратный Kill-Switch для немедленной остановки агента (или курсор в угол 0,0)">
                        <TextBlock Text="Kill: Ctrl+Shift+F12"
                                   FontFamily="Cascadia Code, Consolas"
                                   FontSize="10.5"
                                   Foreground="#7B859A"/>
                    </Border>

                    <Button Content="＋ Новый чат"
                            Style="{StaticResource GhostPillButton}"
                            FontSize="11.5"
                            Padding="9,4"
                            Margin="0,0,5,0"
                            Click="OnClearChatClick"/>

                    <Button Content="📄 Отчёт"
                            Style="{StaticResource GhostPillButton}"
                            FontSize="11.5"
                            Padding="9,4"
                            Margin="0,0,5,0"
                            ToolTip="Экспорт аудиторского отчёта текущей сессии (Markdown / SafeFileSandbox)"
                            Click="OnExportReportClick"/>

                    <!-- Dedicated Settings Gear Button -->
                    <Button x:Name="SettingsGearBtn"
                            Content="⚙ Настройки"
                            Style="{StaticResource DarkButton}"
                            FontSize="11.5"
                            Padding="10,4.5"
                            Margin="0,0,8,0"
                            ToolTip="Добавить нейросеть (Компания, Версия, API-ключ), Безопасность и Песочница"
                            Click="OnOpenSettingsClick"/>

                    <Border Width="1" Height="18" Background="#222836" Margin="0,0,6,0" VerticalAlignment="Center"/>

                    <Button x:Name="WinMinBtn" Content="─" Style="{StaticResource CaptionButton}" ToolTip="Свернуть" Click="OnMinimizeClick"/>
                    <Button x:Name="WinMaxBtn" Style="{StaticResource CaptionButton}" ToolTip="Развернуть" Click="OnMaximizeRestoreClick">
                        <TextBlock x:Name="MaximizeGlyph" Text="□" FontSize="12"/>
                    </Button>
                    <Button x:Name="WinCloseBtn" Content="✕" Style="{StaticResource CaptionCloseButton}" ToolTip="Закрыть" Click="OnCloseWindowClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Clean Full-Width Chat Canvas + Floating Composer -->
        <Grid Grid.Row="1" Background="#0B0D12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Chat Scroll Area -->
            <ScrollViewer x:Name="ChatScroll"
                          Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24,18,24,8">
                <Grid MaxWidth="900" HorizontalAlignment="Stretch">
                    <!-- Empty Welcome Hero (Antigravity + OpenCode minimal command deck) -->
                    <StackPanel x:Name="EmptyStatePanel"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="0,48,0,24">
                        <Border Background="#11151F"
                                BorderBrush="#232B3B"
                                BorderThickness="1"
                                CornerRadius="16"
                                Width="56"
                                Height="56"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,16">
                            <Canvas Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M15,2.5 L25.5,6.8 L25.5,14.8 C25,21.5 21,26 15,28 C9,26 5,21.5 4.5,14.8 L4.5,6.8 Z"
                                      Stroke="#38BDF8"
                                      StrokeThickness="2"
                                      Fill="#2238BDF8"/>
                                <Path Data="M10.5,19 L15,10 L19.5,19"
                                      Stroke="#ECEEF2"
                                      StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                            </Canvas>
                        </Border>

                        <TextBlock Text="Aegis Computer Use"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="#F3F5F8"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6"/>
                        <TextBlock x:Name="EmptyHeroSubtitle"
                                   Text="Добавьте нейросеть в настройках (⚙): выберите компанию, версию модели и API-ключ"
                                   FontSize="13.5"
                                   Foreground="#8B94A6"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="560"
                                   Margin="0,0,0,18"/>

                        <Button x:Name="HeroAddModelBtn"
                                Content="⚙  Подключить нейросеть"
                                Style="{StaticResource PrimaryButton}"
                                Padding="16,9"
                                FontSize="13"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,22"
                                Click="OnOpenSettingsClick"/>

                        <UniformGrid Columns="2" HorizontalAlignment="Center" MaxWidth="620">
                            <Button Style="{StaticResource SlashPromptCard}" Margin="5"
                                    Tag="Опиши, что сейчас открыто на экране, и предложи следующие шаги."
                                    Click="OnQuickPromptClick">
                                <StackPanel>
                                    <TextBlock Text="/screen  •  Computer Use" FontFamily="Cascadia Code, Consolas" FontSize="11" Foreground="#38BDF8" Margin="0,0,0,3"/>
                                    <TextBlock Text="Анализ текущего экрана и управление" FontSize="12.5" Foreground="#DCE3EE"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SlashPromptCard}" Margin="5"
                                    Tag="Создай структурированный отчёт report.docx и таблицу data.xlsx в песочнице."
                                    Click="OnQuickPromptClick">
                                <StackPanel>
                                    <TextBlock Text="/files  •  Safe Sandbox" FontFamily="Cascadia Code, Consolas" FontSize="11" Foreground="#34D399" Margin="0,0,0,3"/>
                                    <TextBlock Text="Создать DOCX, XLSX, PDF или график PNG" FontSize="12.5" Foreground="#DCE3EE"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SlashPromptCard}" Margin="5"
                                    Tag="Напиши чистый оптимизированный Python-скрипт с комментариями и примером."
                                    Click="OnQuickPromptClick">
                                <StackPanel>
                                    <TextBlock Text="/code  •  Developer" FontFamily="Cascadia Code, Consolas" FontSize="11" Foreground="#C084FC" Margin="0,0,0,3"/>
                                    <TextBlock Text="Сгенерировать код с подсветкой" FontSize="12.5" Foreground="#DCE3EE"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SlashPromptCard}" Margin="5"
                                    Tag="Проверь прикреплённый скриншот или файл и разбери детали по шагам."
                                    Click="OnQuickPromptClick">
                                <StackPanel>
                                    <TextBlock Text="/vision  •  Ctrl+V / Drop" FontFamily="Cascadia Code, Consolas" FontSize="11" Foreground="#F59E0B" Margin="0,0,0,3"/>
                                    <TextBlock Text="Разбор скриншота из буфера или видео" FontSize="12.5" Foreground="#DCE3EE"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>

                    <!-- Rich Selectable Chat Stream -->
                    <StackPanel>
                        <ItemsControl x:Name="ChatItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding CardBackground}"
                                            BorderBrush="{Binding CardBorder}"
                                            BorderThickness="{Binding CardBorderThickness}"
                                            CornerRadius="{Binding CardCornerRadius}"
                                            Padding="{Binding CardPadding}"
                                            Margin="{Binding CardMargin}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,5" Visibility="{Binding HeaderVisibility}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding IconBadge}" Margin="0,0,6,0" FontSize="12.5" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="12" Foreground="{Binding HeaderBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="#647084" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding MessageImages}" Margin="0,2,0,8" Visibility="{Binding HasMessageImages}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="8" BorderBrush="#2E3646" BorderThickness="1" Margin="0,0,6,6" ClipToBounds="True">
                                                            <Image Source="{Binding}" Width="92" Height="68" Stretch="UniformToFill"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <ContentPresenter Content="{Binding RichVisual}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Active Model Thinking Pill -->
                        <Border x:Name="AgentRunningPill"
                                Visibility="Collapsed"
                                Background="#14171F"
                                BorderBrush="#262C38"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12,7"
                                HorizontalAlignment="Left"
                                Margin="0,4,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✨" Foreground="#38BDF8" Margin="0,0,8,0"/>
                                <TextBlock x:Name="AgentRunningLabel" Text="Модель думает и анализирует..." FontSize="12" Foreground="#A1A8B8"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Floating Modern Composer -->
            <Grid Grid.Row="1" MaxWidth="920" Margin="24,4,24,18">
                <Border Style="{StaticResource ComposerCardStyle}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.35" Color="#000000"/>
                    </Border.Effect>

                    <StackPanel>
                        <!-- Attachments Strip (Ctrl+V images + dropped files) -->
                        <ItemsControl x:Name="AttachmentsList" Margin="0,0,0,6" Visibility="Collapsed">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,8,8">
                                        <Border x:Name="ThumbTile"
                                                Width="56"
                                                Height="56"
                                                CornerRadius="10"
                                                BorderBrush="#323A4B"
                                                BorderThickness="1"
                                                Background="#0D0F14"
                                                ClipToBounds="True"
                                                ToolTip="{Binding DisplayLabel}">
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                                <Button Content="✕"
                                                        Tag="{Binding}"
                                                        Width="18"
                                                        Height="18"
                                                        FontSize="9.5"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="2"
                                                        Cursor="Hand"
                                                        Background="#CC11141B"
                                                        Foreground="#F87171"
                                                        BorderThickness="0"
                                                        Click="OnRemoveAttachmentClick"/>
                                            </Grid>
                                        </Border>

                                        <Border x:Name="FilePill"
                                                Visibility="Collapsed"
                                                Background="#1B202B"
                                                BorderBrush="#2D3546"
                                                BorderThickness="1"
                                                CornerRadius="9"
                                                Padding="8,5">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TypeIcon}" Margin="0,0,6,0" FontSize="12"/>
                                                <TextBlock Text="{Binding DisplayLabel}" FontSize="11.5" Foreground="#E2E8F0" MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <Button Content="✕"
                                                        Tag="{Binding}"
                                                        Margin="6,0,0,0"
                                                        Padding="3,0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Foreground="#F87171"
                                                        Cursor="Hand"
                                                        Click="OnRemoveAttachmentClick"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsImage}" Value="False">
                                            <Setter TargetName="ThumbTile" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="FilePill" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Prompt Text Box -->
                        <Grid MinHeight="44" MaxHeight="150" Margin="2,2,2,8">
                            <TextBlock x:Name="PromptPlaceholder"
                                       Text="Напишите задачу, вставьте фото (Ctrl+V) или перетащите файлы..."
                                       Foreground="#647084"
                                       FontSize="13.5"
                                       Margin="4,4,0,0"
                                       IsHitTestVisible="False"/>

                            <TextBox x:Name="PromptBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="3,3"
                                     FontSize="13.5"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     TextChanged="OnPromptTextChanged"
                                     PreviewKeyDown="OnPromptPreviewKeyDown"/>
                        </Grid>

                        <!-- Bottom Composer Action Bar -->
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- + Attachment Button -->
                            <Button x:Name="AddAttachmentBtn"
                                    Grid.Column="0"
                                    Content="＋"
                                    FontSize="16"
                                    Width="30"
                                    Height="30"
                                    Padding="0"
                                    Margin="0,0,4,0"
                                    Style="{StaticResource GhostPillButton}"
                                    ToolTip="Прикрепить фото, видео, аудио, PDF или код (или Ctrl+V)"
                                    Click="OnAddAttachmentClick"/>

                            <!-- Clean Unified Model Selector Pill (ONLY added models + hover power) -->
                            <Button x:Name="UnifiedModelButton"
                                    Grid.Column="1"
                                    Style="{StaticResource GhostPillButton}"
                                    Padding="10,4"
                                    Click="OnUnifiedModelButtonClick"
                                    ToolTip="Выбор добавленной модели, мощности (Low/Medium/High) и статистики токенов">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⌄" FontSize="11" Foreground="#8B94A6" Margin="0,0,6,1" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="UnifiedModelLabel" Text="Модель не выбрана" FontSize="12.5" FontWeight="SemiBold" Foreground="#ECEEF2" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="UnifiedThinkingLabel" Text="" FontSize="12" Foreground="#8B94A6" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Dedicated Parameters & Screen Scope Pill -->
                            <Button x:Name="AgentParamsButton"
                                    Grid.Column="2"
                                    Style="{StaticResource GhostPillButton}"
                                    Padding="8,4"
                                    Margin="4,0,0,0"
                                    Click="OnAgentParamsButtonClick"
                                    ToolTip="Режим (Экран / Чат), шаги за промпт, файлы и область захвата">
                                <Border Background="#1B2230" BorderBrush="#2D374B" BorderThickness="1" CornerRadius="9" Padding="8,2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🎛" FontSize="10.5" Foreground="#38BDF8" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="UnifiedScopeBadge" Text="Экран • 25 ш." FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Button>

                            <!-- Context Window Ring Indicator -->
                            <controls:ContextRingControl x:Name="ContextRing"
                                                         Grid.Column="4"
                                                         Margin="0,0,8,0"
                                                         MouseLeftButtonUp="OnContextRingClick"/>

                            <!-- Live Voice Continuous Mode Button -->
                            <Button x:Name="LiveVoiceToggleBtn"
                                    Grid.Column="5"
                                    Style="{StaticResource GhostPillButton}"
                                    Padding="8,4"
                                    Margin="0,0,6,0"
                                    ToolTip="Непрерывное голосовое управление в реальном времени (говорите без нажатия кнопок, Alt+V)"
                                    Click="OnLiveVoiceToggleClick">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="LiveVoiceDot" Width="7" Height="7" Fill="#647084" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LiveVoiceText" Text="Live Голос" FontSize="11.5" Foreground="#CBD5E1"/>
                                </StackPanel>
                            </Button>

                            <!-- Voice Mic Button -->
                            <Button x:Name="VoiceButton"
                                    Grid.Column="6"
                                    Content="🎙"
                                    FontSize="13.5"
                                    Width="34"
                                    Height="32"
                                    Padding="0"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource GhostPillButton}"
                                    ToolTip="Голосовая команда (запись в RAM)"
                                    Click="OnVoiceToggleClick"/>

                            <!-- Send / Kill-Switch Button -->
                            <Grid Grid.Column="7">
                                <Button x:Name="RunButton"
                                        Content="↑"
                                        FontSize="15"
                                        FontWeight="Bold"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        Style="{StaticResource PrimaryButton}"
                                        ToolTip="Отправить задачу (Enter)"
                                        Click="OnRunClick"/>

                                <Button x:Name="StopButton"
                                        Content="⛔ Стоп"
                                        Height="32"
                                        Padding="12,0"
                                        FontSize="12"
                                        Style="{StaticResource DangerButton}"
                                        Visibility="Collapsed"
                                        ToolTip="Остановить агента (Ctrl+Shift+F12)"
                                        Click="OnStopClick"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- In-Window Interactive Agent Parameters & Scope Panel (never steals Win32 HWND focus!) -->
            <Grid Grid.Row="0"
                  MaxWidth="920"
                  Margin="24,0,24,8"
                  VerticalAlignment="Bottom"
                  HorizontalAlignment="Stretch"
                  Panel.ZIndex="40">
                <Border x:Name="AgentParamsPanel"
                        Visibility="Collapsed"
                        HorizontalAlignment="Left"
                        Width="390"
                        MaxHeight="470"
                        Background="#151923"
                        BorderBrush="#2C3446"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14,12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.6" Color="#000000"/>
                    </Border.Effect>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="444">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Параметры агента и экрана" FontSize="13" FontWeight="SemiBold" Foreground="#ECEEF2" VerticalAlignment="Center"/>
                                <Button Content="✕"
                                        HorizontalAlignment="Right"
                                        Width="24"
                                        Height="24"
                                        Padding="0"
                                        FontSize="10.5"
                                        Style="{StaticResource GhostPillButton}"
                                        Click="OnCloseAgentParamsClick"/>
                            </Grid>

                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <Button x:Name="QuickScreenModeBtn"
                                        Content="🖥 С экраном"
                                        Style="{StaticResource PrimaryButton}"
                                        Padding="8,6"
                                        FontSize="12"
                                        Margin="0,0,4,0"
                                        Click="OnQuickScreenModeClick"/>
                                <Button x:Name="QuickChatModeBtn"
                                        Content="💬 Быстрый чат"
                                        Style="{StaticResource DarkButton}"
                                        Padding="8,6"
                                        FontSize="12"
                                        Margin="4,0,0,0"
                                        Click="OnQuickChatModeClick"/>
                            </UniformGrid>

                            <Border Background="#10141D" BorderBrush="#232A39" BorderThickness="1" CornerRadius="10" Padding="10,9" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,7">
                                        <TextBlock Text="Макс. шагов за промпт" FontSize="12" FontWeight="Medium" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="StepDecrementBtn"
                                                    Content="−"
                                                    Width="28"
                                                    Height="26"
                                                    Padding="0"
                                                    FontSize="14"
                                                    FontWeight="Bold"
                                                    Style="{StaticResource DarkButton}"
                                                    Click="OnStepDecrementClick"/>
                                            <TextBox x:Name="MaxStepsBox"
                                                     Text="25"
                                                     Width="50"
                                                     Height="26"
                                                     Margin="5,0"
                                                     Padding="4,2"
                                                     FontWeight="SemiBold"
                                                     TextAlignment="Center"
                                                     VerticalContentAlignment="Center"
                                                     TextChanged="OnMaxStepsTextChanged"/>
                                            <Button x:Name="StepIncrementBtn"
                                                    Content="＋"
                                                    Width="28"
                                                    Height="26"
                                                    Padding="0"
                                                    FontSize="13"
                                                    FontWeight="Bold"
                                                    Style="{StaticResource DarkButton}"
                                                    Click="OnStepIncrementClick"/>
                                        </StackPanel>
                                    </Grid>
                                    <UniformGrid Columns="4">
                                        <Button Content="5" Tag="5" Style="{StaticResource GhostPillButton}" FontSize="11" Padding="4,3" Margin="0,0,3,0" Click="OnStepPresetClick"/>
                                        <Button Content="15" Tag="15" Style="{StaticResource GhostPillButton}" FontSize="11" Padding="4,3" Margin="2,0,2,0" Click="OnStepPresetClick"/>
                                        <Button Content="25" Tag="25" Style="{StaticResource GhostPillButton}" FontSize="11" Padding="4,3" Margin="2,0,2,0" Click="OnStepPresetClick"/>
                                        <Button Content="50" Tag="50" Style="{StaticResource GhostPillButton}" FontSize="11" Padding="4,3" Margin="3,0,0,0" Click="OnStepPresetClick"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <CheckBox x:Name="EnableComputerUseCheck"
                                      Content="Computer Use (управление мышью и клавиатурой)"
                                      FontSize="12"
                                      IsChecked="True"
                                      Margin="2,0,2,7"
                                      Checked="OnToolToggleChanged"
                                      Unchecked="OnToolToggleChanged"/>
                            <CheckBox x:Name="EnableFileCreationCheck"
                                      Content="Создавать файлы (DOCX, XLSX, PDF, код, PNG)"
                                      FontSize="12"
                                      IsChecked="True"
                                      Margin="2,0,2,7"/>
                            <CheckBox x:Name="AutoSendVoiceCheck"
                                      Content="Авто-отправка после голосового ввода"
                                      FontSize="12"
                                      IsChecked="False"
                                      Margin="2,0,2,7"/>
                            <CheckBox x:Name="AutoFallbackOnOverloadCheck"
                                      Content="Авто-резерв при перегрузке (HTTP 503 → запасная модель)"
                                      ToolTip="Если выбранная модель недоступна из-за пика нагрузки (HTTP 503), автоматически выполнить запрос через резервную модель (напр. gemini-2.5-flash)"
                                      FontSize="12"
                                      IsChecked="True"
                                      Margin="2,0,2,7"/>
                            <CheckBox x:Name="LiveVoiceModeCheck"
                                      Content="Непрерывный Live Голос в реальном времени (Alt+V)"
                                      ToolTip="Слушать речь непрерывно и выполнять команды без нажатия кнопок мыши"
                                      FontSize="12"
                                      IsChecked="False"
                                      Margin="2,0,2,7"
                                      Checked="OnLiveVoiceCheckChanged"
                                      Unchecked="OnLiveVoiceCheckChanged"/>
                            <CheckBox x:Name="RealTimeScreenWatchCheck"
                                      Content="Анализировать в реальном времени только экран"
                                      ToolTip="Агент фокусируется строго на видимом содержимом экрана в реальном времени"
                                      FontSize="12"
                                      IsChecked="True"
                                      Margin="2,0,2,10"/>

                            <Border Height="1" Background="#242A38" Margin="0,0,0,8"/>

                            <Grid Margin="2,0,2,6">
                                <TextBlock Text="Область захвата экрана" FontSize="11.5" FontWeight="SemiBold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                <Button Content="↻ Обновить"
                                        ToolTip="Обновить список открытых окон"
                                        HorizontalAlignment="Right"
                                        Padding="8,2.5"
                                        FontSize="11"
                                        Style="{StaticResource GhostPillButton}"
                                        Click="OnRefreshWindowsClick"/>
                            </Grid>

                            <ScrollViewer MaxHeight="165" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="WindowScopeRows">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource PopupRowButton}"
                                                    Background="{Binding RowBackground}"
                                                    Padding="8,6"
                                                    Tag="{Binding}"
                                                    Click="OnSelectWindowScopeClick">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding DisplayLabel}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="#E5E7EB"/>
                                                    <TextBlock Grid.Column="1" Text="✓" Foreground="#38BDF8" Visibility="{Binding CheckVisibility}" Margin="8,0,0,0"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- SETTINGS MODAL OVERLAY (replaces left sidebar cleanly, inherits WDA_EXCLUDEFROMCAPTURE!) -->
        <Grid x:Name="SettingsOverlay"
              Grid.RowSpan="2"
              Background="#B807090E"
              Visibility="Collapsed"
              MouseDown="OnSettingsBackdropMouseDown">
            <Border Background="#14171F"
                    BorderBrush="#29303F"
                    BorderThickness="1"
                    CornerRadius="16"
                    Width="760"
                    MaxWidth="860"
                    MaxHeight="680"
                    Margin="24"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    MouseDown="OnSettingsModalContentMouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.65" Color="#000000"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Modal Header + Tabs -->
                    <Border Grid.Row="0" Background="#11141B" BorderBrush="#222733" BorderThickness="0,0,0,1" CornerRadius="16,16,0,0" Padding="18,12">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚙ Настройки Aegis" FontSize="15.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0"/>

                                <Button x:Name="TabModelsBtn" Content="🤖 Нейросети и API" Style="{StaticResource DarkButton}" Padding="10,5" FontSize="12" Margin="0,0,6,0" Click="OnSwitchSettingsTabClick" Tag="Models"/>
                                <Button x:Name="TabSecurityBtn" Content="🛡 Безопасность" Style="{StaticResource GhostPillButton}" Padding="10,5" FontSize="12" Margin="0,0,6,0" Click="OnSwitchSettingsTabClick" Tag="Security"/>
                                <Button x:Name="TabSandboxBtn" Content="📁 Песочница" Style="{StaticResource GhostPillButton}" Padding="10,5" FontSize="12" Click="OnSwitchSettingsTabClick" Tag="Sandbox"/>
                            </StackPanel>

                            <Button Content="✕"
                                    HorizontalAlignment="Right"
                                    Width="30"
                                    Height="30"
                                    Padding="0"
                                    Style="{StaticResource GhostPillButton}"
                                    Click="OnCloseSettingsClick"/>
                        </Grid>
                    </Border>

                    <!-- Modal Scrollable Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16,20,20">
                        <StackPanel>
                            <!-- TAB 1: Models & API Keys -->
                            <StackPanel x:Name="SettingsTabModels">
                                <!-- Locked Vault Unlock Banner (only visible if Vault on disk needs passphrase/unlock) -->
                                <Border x:Name="UnlockVaultBanner"
                                        Visibility="Collapsed"
                                        Background="#12212E"
                                        BorderBrush="#1E4E75"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14"
                                        Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="🔓 Обнаружен зашифрованный Vault моделей" FontWeight="SemiBold" Foreground="#7DD3FC" Margin="0,0,0,4"/>
                                        <TextBlock Text="Введите мастер-пароль для расшифровки сохранённых моделей и API-ключей в защищённую RAM." FontSize="11.5" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <PasswordBox x:Name="UnlockVaultPassBox" Margin="0,0,8,0"/>
                                            <Button Grid.Column="1" Content="Разблокировать" Style="{StaticResource PrimaryButton}" Padding="12,6" Click="OnUnlockMultiVaultClick"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Step-by-step Add Neural Network Card -->
                                <Border Background="#11141B" BorderBrush="#252C3A" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Добавить новую нейросеть" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                        <!-- Step 1: Company -->
                                        <TextBlock Text="1. Компания (Провайдер)" FontSize="11.5" Foreground="#8B94A6" Margin="0,0,0,6"/>
                                        <UniformGrid Columns="3" Margin="0,0,0,12">
                                            <Button x:Name="ProviderGoogleBtn" Content="Google (Gemini)" Tag="GoogleGemini" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Padding="8,7" Click="OnSelectProviderClick"/>
                                            <Button x:Name="ProviderOpenAiBtn" Content="OpenAI" Tag="OpenAI" Style="{StaticResource DarkButton}" Margin="3,0,3,0" Padding="8,7" Click="OnSelectProviderClick"/>
                                            <Button x:Name="ProviderAnthropicBtn" Content="Anthropic (Claude)" Tag="Anthropic" Style="{StaticResource DarkButton}" Margin="6,0,0,0" Padding="8,7" Click="OnSelectProviderClick"/>
                                        </UniformGrid>

                                        <!-- Step 2: Model Version -->
                                        <TextBlock Text="2. Версия нейросети" FontSize="11.5" Foreground="#8B94A6" Margin="0,0,0,6"/>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="SettingsVersionCombo"
                                                      Padding="10,7"
                                                      SelectionChanged="OnSettingsVersionChanged"/>
                                            <Button x:Name="LoadModelsFromKeyBtn"
                                                    Grid.Column="1"
                                                    Content="🔄 По ключу"
                                                    Style="{StaticResource DarkButton}"
                                                    Padding="11,7"
                                                    Margin="8,0,0,0"
                                                    FontSize="12"
                                                    ToolTip="Загрузить точный список моделей от провайдера по введённому ниже API-ключу"
                                                    Click="OnLoadModelsFromKeyClick"/>
                                        </Grid>
                                        <TextBlock x:Name="SelectedModelNoteText"
                                                   Text=""
                                                   FontSize="11"
                                                   Foreground="#7D889E"
                                                   Margin="2,0,0,8"
                                                   TextWrapping="Wrap"/>

                                        <Grid x:Name="CustomVersionPanel" Visibility="Collapsed" Margin="0,0,0,10">
                                            <TextBox x:Name="SettingsCustomVersionBox"
                                                     TextChanged="OnCustomVersionTextChanged"
                                                     ToolTip="Введите точный ID модели (например gemini-2.5-flash, gpt-5.4, claude-opus-4-6)"/>
                                            <TextBlock x:Name="CustomVersionHint"
                                                       Text="Точный ID модели (например: gemini-2.5-flash)"
                                                       FontSize="11.5"
                                                       Foreground="#647084"
                                                       Margin="10,0,0,0"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False"/>
                                        </Grid>

                                        <!-- Step 3: API Key -->
                                        <TextBlock Text="3. API-ключ (хранится только в зашифрованном виде)" FontSize="11.5" Foreground="#8B94A6" Margin="0,2,0,6"/>
                                        <PasswordBox x:Name="SettingsApiKeyBox" Margin="0,0,0,12" ToolTip="API-ключ никогда не сохраняется в открытом виде и не попадает в логи"/>

                                        <!-- Step 4: Persistence / Master Passphrase & Add Button -->
                                        <CheckBox x:Name="SettingsPersistVaultCheck"
                                                  Content="Сохранить в зашифрованный локальный Vault (DPAPI CurrentUser + AES-256-GCM)"
                                                  IsChecked="True"
                                                  FontSize="12"
                                                  Margin="0,0,0,8"
                                                  Checked="OnPersistCheckChanged"
                                                  Unchecked="OnPersistCheckChanged"/>

                                        <StackPanel x:Name="SettingsVaultPassPanel" Margin="0,0,0,12">
                                            <TextBlock Text="Мастер-пароль для Vault (опционально — 600 000 итераций PBKDF2-SHA256):" FontSize="11" Foreground="#8B94A6" Margin="0,0,0,4"/>
                                            <PasswordBox x:Name="SettingsMasterPassBox"/>
                                        </StackPanel>

                                        <TextBlock x:Name="SettingsAddErrorText" Text="" Foreground="#F87171" FontSize="11.5" Visibility="Collapsed" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="SettingsAddSuccessText" Text="" Foreground="#34D399" FontSize="11.5" Visibility="Collapsed" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Button x:Name="AddModelConfirmBtn"
                                                    Content="＋ Добавить нейросеть"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Padding="14,9"
                                                    FontSize="13"
                                                    Margin="0,0,8,0"
                                                    Click="OnAddModelConfirmClick"/>
                                            <Button x:Name="ProbeModelBtn"
                                                    Content="⚡ Проверить ключ"
                                                    Style="{StaticResource DarkButton}"
                                                    Padding="12,9"
                                                    FontSize="12.5"
                                                    ToolTip="Проверить доступность выбранной модели с этим ключом без сброса полей"
                                                    Click="OnProbeModelClick"/>
                                        </StackPanel>
                                        <TextBlock Text="Квота Google AI Studio (Free Tier или Billing) привязана к GCP-проекту ключа и не использует лимиты подписки IDE."
                                                   FontSize="10.5"
                                                   Foreground="#6B7280"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Network & Proxy Settings (Bypass 403 geo-blocking) -->
                                <Border Background="#10141D" BorderBrush="#232A39" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="🌐 Сеть и Прокси (обход ошибки 403 Google Gemini)" FontSize="12" FontWeight="SemiBold" Foreground="#ECEEF2"/>
                                            <TextBlock Text="HTTP / SOCKS5" FontSize="11" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <TextBlock Text="Если Google возвращает 403 (User location is not supported), укажите адрес локального VPN/прокси:"
                                                   FontSize="11" Foreground="#8B94A6" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,8">
                                            <TextBox x:Name="SettingsProxyBox"
                                                     Height="28"
                                                     Padding="6,3"
                                                     FontSize="11.5"
                                                     TextChanged="OnProxyTextChanged"/>
                                            <TextBlock x:Name="SettingsProxyHint"
                                                       Text="Например: http://127.0.0.1:7890 или socks5://127.0.0.1:10808 (пусто = системный)"
                                                       FontSize="11"
                                                       Foreground="#647084"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Clash (7890)" Style="{StaticResource GhostPillButton}" FontSize="11" Padding="6,3" Margin="0,0,6,0" Click="OnPresetProxyClashClick"/>
                                            <Button Content="v2ray (10809)" Style="{StaticResource GhostPillButton}" FontSize="11" Padding="6,3" Margin="0,0,6,0" Click="OnPresetProxyV2RayClick"/>
                                            <Button Content="Системный" Style="{StaticResource GhostPillButton}" FontSize="11" Padding="6,3" Margin="0,0,6,0" Click="OnPresetProxySystemClick"/>
                                            <Button Content="Сбросить" Style="{StaticResource GhostPillButton}" FontSize="11" Padding="6,3" Click="OnPresetProxyClearClick"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- List of Added Neural Networks -->
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Добавленные нейросети" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ConfiguredCountText" Text="0 шт." FontSize="12" Foreground="#8B94A6" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <Border x:Name="NoConfiguredModelsHint"
                                        Background="#11141B"
                                        BorderBrush="#252C3A"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14"
                                        Margin="0,0,0,8">
                                    <TextBlock Text="Пока не добавлено ни одной нейросети. Добавьте модель выше — только после этого она появится в выборе моделей в чате."
                                               Foreground="#8B94A6"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <ItemsControl x:Name="ConfiguredModelsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#11141B" BorderBrush="{Binding CardBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                            <Border Background="#1D2332" BorderBrush="#2E374D" BorderThickness="1" CornerRadius="6" Padding="6,1" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding ProviderBadge}" FontSize="10.5" Foreground="#38BDF8" FontWeight="SemiBold"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding PowerLabel}" FontSize="11.5" Foreground="#8B94A6" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding SecurityDetails}" FontSize="11" Foreground="#6B7280"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="{Binding ActivateButtonText}"
                                                                Style="{StaticResource DarkButton}"
                                                                Padding="9,5"
                                                                FontSize="11.5"
                                                                Margin="0,0,6,0"
                                                                Tag="{Binding}"
                                                                Click="OnActivateConfiguredModelClick"/>
                                                        <Button Content="Удалить"
                                                                Style="{StaticResource DangerButton}"
                                                                Padding="9,5"
                                                                FontSize="11.5"
                                                                Tag="{Binding}"
                                                                Click="OnDeleteConfiguredModelClick"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- TAB 2: Security Settings -->
                            <StackPanel x:Name="SettingsTabSecurity" Visibility="Collapsed">
                                <Border Background="#11141B" BorderBrush="#252C3A" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Защита экрана и действий Computer Use" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                        <CheckBox x:Name="ExcludeCaptureCheck"
                                                  Content="Скрывать окно Aegis от скриншотов и захвата экрана (WDA_EXCLUDEFROMCAPTURE)"
                                                  IsChecked="True"
                                                  Margin="0,0,0,10"
                                                  Checked="OnExcludeCaptureChanged"
                                                  Unchecked="OnExcludeCaptureChanged"/>

                                        <CheckBox x:Name="SensitiveWindowCheck"
                                                  Content="Ставить захват и клики на паузу, если открыт менеджер паролей или UAC"
                                                  IsChecked="True"
                                                  Margin="0,0,0,10"/>

                                        <CheckBox x:Name="CommandConfirmCheck"
                                                  Content="Требовать ручное подтверждение при вводе потенциально опасных shell-команд"
                                                  IsChecked="True"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#11141B" BorderBrush="#252C3A" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Уровень защиты процесса и сети" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="SecurityDiagText"
                                                   Text="• Только System32 DLL Search&#x0a;• Heap Termination on Corruption&#x0a;• Strict TLS 1.2/1.3 + SAN Certificate Verification + Zero Redirects&#x0a;• Ephemeral RAM AES-256-GCM + CryptProtectMemory"
                                                   FontSize="12"
                                                   Foreground="#9CA3AF"
                                                   LineHeight="20"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#211215" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="12" Padding="16">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Экстренная очистка секретов" FontWeight="SemiBold" Foreground="#FCA5A5" Margin="0,0,0,4"/>
                                            <TextBlock Text="Немедленно затирает все API-ключи в RAM нулями и безвозвратно перезаписывает файл Vault на диске." FontSize="11.5" Foreground="#CBD5E1" TextWrapping="Wrap" MaxWidth="470" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                        <Button x:Name="SettingsWipeAllBtn"
                                                Content="🧹 Стереть всё"
                                                Style="{StaticResource DangerButton}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Padding="12,7"
                                                Click="OnWipeAllKeysClick"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- TAB 3: Sandbox & Created Files -->
                            <StackPanel x:Name="SettingsTabSandbox" Visibility="Collapsed">
                                <Border Background="#11141B" BorderBrush="#252C3A" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Песочница создаваемых нейросетью файлов" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <TextBlock Text="ИИ может создавать файлы (DOCX, XLSX, PDF, PNG, код и др.) только внутри выбранной папки без выхода за пределы." FontSize="12" Foreground="#8B94A6" Margin="0,0,0,10" TextWrapping="Wrap"/>

                                        <Border Background="#0D0F14" BorderBrush="#262C38" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                                            <TextBlock x:Name="SandboxPathText" FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                                        </Border>

                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Выбрать папку" Style="{StaticResource DarkButton}" Margin="0,0,8,0" Click="OnPickSandboxClick"/>
                                            <Button Content="Открыть в Проводнике" Style="{StaticResource PrimaryButton}" Click="OnOpenSandboxClick"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Background="#11141B" BorderBrush="#252C3A" BorderThickness="1" CornerRadius="12" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Созданные в этой сессии файлы" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <ItemsControl x:Name="CreatedFilesList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource PopupRowButton}"
                                                            Padding="8,7"
                                                            Margin="0,0,0,4"
                                                            Tag="{Binding}"
                                                            Click="OnOpenCreatedFileClick">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="📄 " Foreground="#34D399" FontSize="12"/>
                                                            <TextBlock Text="{Binding DisplayLabel}" Foreground="#A7F3D0" FontSize="12"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- POPUP 1: Main Unified Model Popup (ONLY added models!) -->
        <Popup x:Name="UnifiedSelectorPopup"
               PlacementTarget="{Binding ElementName=UnifiedModelButton}"
               Placement="Top"
               VerticalOffset="-8"
               AllowsTransparency="True"
               StaysOpen="True"
               PreviewKeyDown="OnPopupPreviewKeyDown">
            <Border Background="#161922"
                    BorderBrush="#2A303E"
                    BorderThickness="1"
                    CornerRadius="12"
                    Width="300"
                    Padding="6">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
                </Border.Effect>

                <StackPanel>
                    <Grid Margin="10,5,8,4">
                        <TextBlock Text="Добавленные модели"
                                   FontSize="11.5"
                                   Foreground="#8B94A6"
                                   VerticalAlignment="Center"/>
                        <Button Content="＋"
                                ToolTip="Добавить модель в настройках"
                                HorizontalAlignment="Right"
                                Padding="6,1"
                                FontSize="12"
                                Style="{StaticResource GhostPillButton}"
                                Click="OnPopupGoToAddModelClick"/>
                    </Grid>

                    <!-- Shown ONLY when 0 models are configured -->
                    <StackPanel x:Name="PopupNoModelsPanel" Margin="8,4,8,6">
                        <TextBlock Text="Нет добавленных моделей"
                                   FontSize="12"
                                   Foreground="#8B94A6"
                                   Margin="2,0,2,8"/>
                        <Button Content="⚙  Добавить нейросеть"
                                Style="{StaticResource PrimaryButton}"
                                Padding="10,7"
                                FontSize="12"
                                Click="OnPopupGoToAddModelClick"/>
                    </StackPanel>

                    <!-- Added Model Rows ONLY -->
                    <ItemsControl x:Name="ModelRowsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource PopupRowButton}"
                                        Background="{Binding RowBackground}"
                                        Padding="10,7"
                                        Tag="{Binding}"
                                        MouseEnter="OnModelRowMouseEnter"
                                        Click="OnModelRowClick">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="12.5"
                                                   FontWeight="{Binding DisplayWeight}"
                                                   Foreground="#ECEEF2"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ThinkingBadge}"
                                                   FontSize="12"
                                                   Foreground="#8B94A6"
                                                   Margin="7,0,0,0"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="3"
                                                   Text="›"
                                                   FontSize="14"
                                                   Foreground="#9CA3AF"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="1" Background="#252A36" Margin="6,4"/>

                    <!-- View Usage Row -->
                    <Button Style="{StaticResource PopupRowButton}"
                            Padding="10,7"
                            MouseEnter="OnNonSubmenuRowMouseEnter"
                            Click="OnViewUsageRowClick">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="◔" FontSize="13" Foreground="#9CA3AF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Статистика токенов (Usage)" FontSize="12.5" Foreground="#E5E7EB" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="›" FontSize="14" Foreground="#6B7280" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <!-- POPUP 2: Cascading Thinking Power Submenu (snapped right next to hovered model arrow ›) -->
        <Popup x:Name="ThinkingSubmenuPopup"
               Placement="Right"
               HorizontalOffset="1"
               VerticalOffset="-5"
               AllowsTransparency="True"
               StaysOpen="True"
               PreviewKeyDown="OnPopupPreviewKeyDown">
            <Border Background="#161922"
                    BorderBrush="#2A303E"
                    BorderThickness="1"
                    CornerRadius="11"
                    Width="195"
                    Padding="5"
                    MouseEnter="OnSubmenuMouseEnter">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <Button x:Name="ThinkingLowBtn" Style="{StaticResource PopupRowButton}" Tag="LOW" Padding="10,7" Click="OnThinkingOptionClick">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Low" FontSize="12.5" Foreground="#ECEEF2"/>
                                <TextBlock Text="Быстро" FontSize="11" Foreground="#34D399" Margin="8,1,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="CheckLow" Text="✓" HorizontalAlignment="Right" Foreground="#ECEEF2" Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                    <Button x:Name="ThinkingMediumBtn" Style="{StaticResource PopupRowButton}" Tag="MEDIUM" Padding="10,7" Click="OnThinkingOptionClick">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Medium" FontSize="12.5" Foreground="#ECEEF2"/>
                                <TextBlock Text="Баланс" FontSize="11" Foreground="#38BDF8" Margin="8,1,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="CheckMedium" Text="✓" HorizontalAlignment="Right" Foreground="#ECEEF2" Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                    <Button x:Name="ThinkingHighBtn" Style="{StaticResource PopupRowButton}" Tag="HIGH" Padding="10,7" Click="OnThinkingOptionClick">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="High" FontSize="12.5" Foreground="#ECEEF2"/>
                                <TextBlock Text="Глубоко" FontSize="11" Foreground="#A78BFA" Margin="8,1,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="CheckHigh" Text="✓" HorizontalAlignment="Right" Foreground="#ECEEF2" Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <!-- POPUP 4: Context Usage Details Popover -->
        <Popup x:Name="UsagePopup"
               PlacementTarget="{Binding ElementName=ContextRing}"
               Placement="Top"
               VerticalOffset="-8"
               AllowsTransparency="True"
               StaysOpen="True"
               PreviewKeyDown="OnPopupPreviewKeyDown">
            <Border Background="#161922"
                    BorderBrush="#2A303E"
                    BorderThickness="1"
                    CornerRadius="12"
                    Width="290"
                    Padding="14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.55" Color="#000000"/>
                </Border.Effect>

                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Использование контекста" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock x:Name="UsagePercentText" Text="0%" Foreground="#38BDF8" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>

                    <ProgressBar x:Name="UsageProgressBar"
                                 Height="6"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Background="#242936"
                                 Foreground="#38BDF8"
                                 BorderThickness="0"
                                 Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,5">
                        <TextBlock Text="Вход (Prompt):" Foreground="#8B94A6" FontSize="12"/>
                        <TextBlock x:Name="UsagePromptText" Text="0" FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,5">
                        <TextBlock Text="Ответ (Output):" Foreground="#8B94A6" FontSize="12"/>
                        <TextBlock x:Name="UsageOutputText" Text="0" FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,5">
                        <TextBlock Text="Размышления (Thoughts):" Foreground="#8B94A6" FontSize="12"/>
                        <TextBlock x:Name="UsageThoughtsText" Text="0" FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Кэшировано (Cached):" Foreground="#8B94A6" FontSize="12"/>
                        <TextBlock x:Name="UsageCachedText" Text="0" FontSize="12" Foreground="#34D399" HorizontalAlignment="Right"/>
                    </Grid>

                    <Border Height="1" Background="#252A36" Margin="0,2,0,8"/>

                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Текущее окно:" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock x:Name="UsageWindowTotalText" Text="0 / 1 048 576" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="Суммарно за сессию:" Foreground="#8B94A6" FontSize="11.5"/>
                        <TextBlock x:Name="UsageSessionTotalText" Text="0" Foreground="#8B94A6" FontSize="11.5" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
        </Grid>
    </Border>
</Window>
